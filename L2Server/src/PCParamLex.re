#include <cstring>
#include <string>
#include <string_view>
#include <vector>
#include <cstdint>

#include "PCParamYaccTokens.h"

namespace {

std::string ToAscii(std::u16string_view value) {
    std::string ascii;
    ascii.reserve(value.size());
    for (const char16_t codeUnit : value) {
        if (codeUnit > 0x7f) {
            return {};
        }
        ascii.push_back(static_cast<char>(codeUnit));
    }
    return ascii;
}

std::int64_t ParseWindowsInt64(std::u16string_view value) {
    const std::string ascii = ToAscii(value);
    if (ascii.empty() && !value.empty()) {
        return 0;
    }

    errno = 0;
    char* end = nullptr;
    const long long parsed = std::strtoll(ascii.c_str(), &end, 10);
    if (end == ascii.c_str()) {
        return 0;
    }
    if (errno == ERANGE) {
        return parsed < 0 ? INT64_MIN : INT64_MAX;
    }
    return static_cast<std::int64_t>(parsed);
}

double ParseWindowsDouble(std::u16string_view value) {
    const std::string ascii = ToAscii(value);
    if (ascii.empty() && !value.empty()) {
        return 0.0;
    }

    char* end = nullptr;
    const double parsed = std::strtod(ascii.c_str(), &end);
    return end == ascii.c_str() ? 0.0 : parsed;
}

char16_t* DuplicateText(const char16_t* text, int length) {
    auto* const duplicate = static_cast<char16_t*>(std::malloc(static_cast<std::size_t>(length + 1) * sizeof(char16_t)));
    if (duplicate == nullptr) {
        return nullptr;
    }
    std::copy_n(text, length, duplicate);
    duplicate[length] = u'\0';
    return duplicate;
}

} // namespace

CLexerForPCParam::CLexerForPCParam() :
    m_FileBuf(nullptr), m_pRawFileBuf(nullptr), m_nFilePointer(0), m_nFileSize(0), line(0) {
}

CLexerForPCParam::~CLexerForPCParam() { std::free(m_pRawFileBuf); }

int CLexerForPCParam::Create() {
#if defined(_WIN32)
    constexpr const wchar_t* kFileName = L"..\\Script\\PC_parameter.txt";
#else
    constexpr const wchar_t* kFileName = L"../script/PC_parameter.txt";
#endif
    int byteCount = 0;
    m_pRawFileBuf = LoadBinaryAbsoluteSecure(kFileName, byteCount, true);
    if (m_pRawFileBuf == nullptr) {
        return 0;
    }

    m_nFilePointer = 0;
    m_FileBuf = reinterpret_cast<char16_t*>(m_pRawFileBuf) + 1;
    m_nFileSize = byteCount / 2 - 1;
    return 1;
}

namespace {

