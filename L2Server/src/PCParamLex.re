const Keyword* FindKeyword(const std::u16string_view text) {
    const auto found = std::lower_bound(
        kKeywords.begin(), kKeywords.end(), text,
        [](const Keyword& keyword, const std::u16string_view value) { return keyword.text < value; }
    );
    return found != kKeywords.end() && found->text == text ? &*found : nullptr;
}

} // namespace

int CLexerForPCParam::Lex(grammar::SemanticBits* lval) {
    if (!HasInput()) {
        // The original lexer read m_FileBuf one code unit at a time.
        SetInput(
            m_FileBuf + m_nFilePointer,
            m_nFilePointer < m_nFileSize ? static_cast<std::size_t>(m_nFileSize - m_nFilePointer) : 0
        );
    }
    auto* const semanticSlot = lval;
    for (;;) {
        BeginToken();
        /*!include:re2c "UTF16Scanner.re" */
        /*!re2c
            "//" [^\n]* / "\n" { EndToken(); continue; }
            "/*" .* "*/" { EndToken(); continue; }
            "-"? ("0" | [1-9][0-9]*) "%" {
                EndToken();
                if (yyleng > 0) {
                    yytext[yyleng - 1] = u'\0';
                }
                *semanticSlot = static_cast<grammar::SemanticBits>(
                    ParseWindowsInt64(std::u16string_view(yytext, static_cast<std::size_t>(std::max(0, yyleng - 1))))
                );
                return TK_PERCENT;
            }
            "-"? ("0" | [1-9][0-9]*) {
                EndToken();
                *semanticSlot = static_cast<grammar::SemanticBits>(
                    ParseWindowsInt64(std::u16string_view(yytext, static_cast<std::size_t>(yyleng)))
                );
                return TK_NONE_GROUP;
            }
            "$" ("0" | [1-9][0-9]*) {
                EndToken();
                *semanticSlot = static_cast<grammar::SemanticBits>(
                    ParseWindowsInt64(std::u16string_view(yytext + 1, static_cast<std::size_t>(std::max(0, yyleng - 1))))
                );
                return TK_NONE_GROUP;
            }
            "-"{0,2} ("0" | [1-9][0-9]*) "." [0-9]* {
                EndToken();
                const double value = ParseWindowsDouble(std::u16string_view(yytext, static_cast<std::size_t>(yyleng)));
                std::memcpy(semanticSlot, &value, sizeof(value));
                return TK_FLOAT_NUMBER;
            }
            [&;=_{}] { EndToken(); return grammar::CharacterToken(yytext[0]); }
            "[" [^[\]]* "]" {
                EndToken();
                const int count = std::max(0, yyleng - 2);
                auto* const text =
                    static_cast<char16_t*>(std::malloc(static_cast<std::size_t>(count + 1) * sizeof(char16_t)));
                if (text != nullptr) {
                    std::copy_n(yytext + 1, count, text);
                    text[count] = u'\0';
                    *semanticSlot = grammar::PointerSemantic(text);
                }
                return TK_NAME;
            }
            [a-zA-Z_][a-zA-Z0-9_]* {
                EndToken();
                if (const Keyword* const keyword =
                        FindKeyword(std::u16string_view(yytext, static_cast<std::size_t>(yyleng)))) {
                    if (keyword->hasValue) {
                        *semanticSlot = static_cast<grammar::SemanticBits>(keyword->value);
                    }
                    return keyword->token;
                }
                char16_t* const text = DuplicateText(yytext, yyleng);
                if (text != nullptr) {
                    *semanticSlot = grammar::PointerSemantic(text);
                }
                return TK_IDENTIFIER;
            }
            [ \t\r] { EndToken(); continue; }
            "\n" {
                EndToken();
                ++line;
                continue;
            }
            . {
                EndToken();
                // Log.Add(
                //     LOG_ERROR,
                //     L"[LEXER_ERROR] Invalid char = %s",
                //     yytext)
                // L2_LOG_ERROR(Log,
                //     L"[LEXER_ERROR] Invalid char = %s",
                //     yytext)
                L2_LOG_ERROR(
                    Log, "Unexpected input '%s' (first UTF-16 code unit 0x%04x) at script line %lld; scanning continues.",
                    Utf16ToUtf8(std::u16string_view(yytext, static_cast<std::size_t>(yyleng))).c_str(),
                    static_cast<unsigned>(static_cast<std::uint16_t>(*yytext)), static_cast<long long>(line) + 1
                );
                continue;
            }
            $ { return 0; }
        */
    }
}
